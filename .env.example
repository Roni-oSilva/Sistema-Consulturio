# ============================================================
# Sistema de Agendamento — Clínica JR Saúde
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ============================================================
NODE_ENV=production
PORT=3000
# URL pública do sistema (usada nos links enviados aos pacientes)
PUBLIC_URL=https://agendamento.jrsaude.com.br
DATABASE_URL=postgres://clinica:TROQUE_A_SENHA@db:5432/clinica
POSTGRES_PASSWORD=TROQUE_A_SENHA
# Gere com: openssl rand -base64 48
APP_SECRET=
# 1 quando estiver atrás de proxy reverso (Caddy/Nginx)
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Administrador criado no primeiro "seed" (se vazio, uma senha aleatória é exibida no log)
INITIAL_ADMIN_EMAIL=admin@jrsaude.com.br
INITIAL_ADMIN_PASSWORD=

# Cloudflare Turnstile (CAPTCHA) — opcional, recomendado em produção
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# WhatsApp: manual | evolution | zapi | twilio | meta | webhook | log
#  manual  = sem API: mensagens ficam na fila do painel com botão
#            "Enviar pelo WhatsApp" (1 clique abre o WhatsApp com o texto pronto)
# ------------------------------------------------------------
WHATSAPP_PROVIDER=manual
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# E-mail: none | smtp | log
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="JR Saúde <agendamento@jrsaude.com.br>"

# SMS: none | twilio | webhook | log
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
