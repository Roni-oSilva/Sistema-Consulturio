{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-sql.mjs",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=../.env src/db/seed-cli.ts",
    "seed:demo": "tsx --env-file-if-exists=../.env src/db/seed-cli.ts --demo",
    "create-admin": "tsx --env-file-if-exists=../.env src/db/create-admin-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.5",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
